#!/bin/sh
# Usage: build-skin UPSTREAM_LATENIGHT_DIR OUT
set -eu

HERE=$(dirname -- "$0")
SRC=$1
OUT=$2
DEST=$OUT/skins/LateNight-Leo

die() { printf 'build-skin: %s\n' "$*" >&2; exit 1; }
trim() { printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'; }
pal() { sed -n "s/^$1[[:space:]]\{1,\}\(.*\)$/\1/p" "$HERE/palette.conf" | head -1; }

for key in bg fg surface border border_focus dim accent warn green orange blue \
           cyan magenta neutral_max_s surface_max_s accent_min_s accent_max_s \
           bright_l bright_s_factor alert_min_s alert_max_s font_family \
           font_size alert_pattern; do
    value=$(pal "$key")
    [ -n "$value" ] || die "palette.conf: missing '$key'"
    eval "P_$key=\$value"
done

HUE_FAMILIES=$(
    awk '
        /^[a-z_]+[ \t]+#/ { colors[$1] = $2; next }
        $1 == "hue_family" {
            hex = colors[$4]
            if (hex == "") { print "unknown palette color: " $4 > "/dev/stderr"; exit 1 }
            printf "%s%s %s %s", sep, $2, $3, hex
            sep = "|"
        }
        END { print "" }
    ' "$HERE/palette.conf"
)

expand_palette() {
    sed -e "s|@bg@|$P_bg|g" \
        -e "s|@fg@|$P_fg|g" \
        -e "s|@surface@|$P_surface|g" \
        -e "s|@border@|$P_border|g" \
        -e "s|@border_focus@|$P_border_focus|g" \
        -e "s|@dim@|$P_dim|g" \
        -e "s|@accent@|$P_accent|g" \
        -e "s|@warn@|$P_warn|g" \
        -e "s|@green@|$P_green|g" \
        -e "s|@orange@|$P_orange|g" \
        -e "s|@blue@|$P_blue|g" \
        -e "s|@cyan@|$P_cyan|g" \
        -e "s|@magenta@|$P_magenta|g" \
        -e "s|@font_family@|$P_font_family|g" \
        -e "s|@font_size@|$P_font_size|g" \
        -e "s|@skin@|$DEST|g"
}

recolor() {
    MIN=$P_accent_min_s MAX=$P_accent_max_s
    for pat in $P_alert_pattern; do
        case ${1##*/} in *"$pat"*) MIN=$P_alert_min_s MAX=$P_alert_max_s ;; esac
    done
    shift
    awk -v NEUTRAL_MAX_S="$P_neutral_max_s" \
        -v SURFACE_MAX_S="$P_surface_max_s" \
        -v ACCENT_MIN_S="$MIN" -v ACCENT_MAX_S="$MAX" \
        -v BRIGHT_L="$P_bright_l" -v BRIGHT_S_FACTOR="$P_bright_s_factor" \
        -v HUE_FAMILIES="$HUE_FAMILIES" "$@" -f "$HERE/recolor.awk"
}

mkdir -p "$DEST"
(cd "$SRC" && find . -type f ! -path './classic/*' ! -name 'style_classic.qss' ! -name 'skin_preview_*.png') \
| while IFS= read -r rel; do
    mkdir -p "$DEST/$(dirname "$rel")"
    cp "$SRC/$rel" "$DEST/$rel"
done

awk '
    /<Scheme>/ { buf = $0 "\n"; inblock = 1; isdrop = 0; next }
    inblock {
        buf = buf $0 "\n"
        if ($0 ~ "<Name>Classic</Name>") isdrop = 1
        if ($0 ~ /<\/Scheme>/) {
            if (!isdrop) printf "%s", buf
            inblock = 0
        }
        next
    }
    { print }
' "$DEST/skin.xml" > "$DEST/skin.xml.tmp" && mv "$DEST/skin.xml.tmp" "$DEST/skin.xml"

grep -rho "skins:LateNight/classic/[^\"'<) ]*" "$DEST" | sort -u | while IFS= read -r ref; do
    rel=${ref#skins:LateNight/}
    mkdir -p "$DEST/$(dirname "$rel")"
    cp "$SRC/$rel" "$DEST/$rel"
done

REPLACED_FILES=
while IFS= read -r line <&3; do
    case $line in ''|\#*) continue ;; esac
    rel=$(trim "${line%%|||*}")
    rest=${line#*|||}
    from=$(trim "${rest%%|||*}")
    to=$(trim "${rest#*|||}")
    awk -v from="$from" -v to="$to" '
        {
            out = ""; line = $0
            while ((n = index(line, from)) > 0) {
                out = out substr(line, 1, n - 1) to
                line = substr(line, n + length(from))
                hits++
            }
            print out line
        }
        END { if (!hits) exit 1 }
    ' "$DEST/$rel" > "$DEST/$rel.tmp" || die "replacements.conf: '$from' not found in $rel"
    mv "$DEST/$rel.tmp" "$DEST/$rel"
    case " $REPLACED_FILES " in *" $rel "*) ;; *) REPLACED_FILES="$REPLACED_FILES $rel" ;; esac
done 3< "$HERE/overrides/replacements.conf"

find "$DEST" \( -name '*.xml' -o -name '*.qss' \) -exec sed -i "s|skins:LateNight/|$DEST/|g" {} +

sed -i -e "s|<title>LateNight</title>|<title>LateNight-Leo</title>|" \
       -e "s|<Name>PaleMoon</Name>|<Name>Leo</Name>|" "$DEST/skin.xml"

{
    cat <<'EOF'
<!--
  LateNight-Leo - a recolored derivative of the LateNight skin that ships with
  Mixxx, generated by modules/mixxx/skin/build-skin in
  github.com/LeonhardWeiler/desktop.

  Changes from upstream: colors remapped onto a new palette (hue and
  saturation replaced, lightness kept), the Classic scheme removed, the Leo
  scheme renamed from PaleMoon.

  Upstream LateNight is CC BY-SA 3.0 by jus <s.brandt@mixxx.org>, Owen
  Williams and ronso0; this derivative carries the same license. The original
  notice follows.
-->
EOF
    cat "$DEST/skin.xml"
} > "$DEST/skin.xml.tmp" && mv "$DEST/skin.xml.tmp" "$DEST/skin.xml"

find "$DEST" \( -name '*.svg' -o -name '*.qss' -o -name '*.xml' \) | while IFS= read -r f; do
    recolor "$f" < "$f" > "$f.tmp" && mv "$f.tmp" "$f"
done

for rel in $REPLACED_FILES; do
    expand_palette < "$DEST/$rel" > "$DEST/$rel.tmp" && mv "$DEST/$rel.tmp" "$DEST/$rel"
done

find "$DEST" -name '*.png' | while IFS= read -r f; do
    size=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=s=x:p=0 "$f")
    ffmpeg -v error -i "$f" -f rawvideo -pix_fmt rgba - \
        | od -An -tu1 -v -w4 \
        | LC_ALL=C recolor "$f" -v MODE=pixels \
        | ffmpeg -v error -y -f rawvideo -pix_fmt rgba -s "$size" -i - "$f.tmp.png"
    mv "$f.tmp.png" "$f"
done

sed -i "s|font-family: \"Open Sans Semibold\", \"Open Sans\";|font-family: \"$P_font_family\";|g; \
        s|font-family: \"Open Sans\";|font-family: \"$P_font_family\";|g" "$DEST/style.qss"

while read -r name value _ <&3; do
    case $name in ''|\#*) continue ;; esac
    case $value in '#'*) ;; *) value=$(pal "$value"); [ -n "$value" ] || die "scheme-vars.conf: unknown color for $name" ;; esac
    sed -i "s|\(<SetVariable name=\"$name\">\)[^<]*\(</SetVariable>\)|\1$value\2|" "$DEST/skin.xml"
done 3< "$HERE/overrides/scheme-vars.conf"

expand_palette < "$HERE/overrides/style.qss" >> "$DEST/style_palemoon.qss"
expand_palette < "$HERE/overrides/prefs.qss" > "$OUT/prefs.qss"

mkdir -p "$OUT/qt6ct/colors"
expand_palette < "$HERE/overrides/qt6ct-colors.conf" > "$OUT/qt6ct/colors/Leo.conf"
expand_palette < "$HERE/overrides/qt6ct.conf" \
    | sed -e "s|@colors_path@|$OUT/qt6ct/colors/Leo.conf|" > "$OUT/qt6ct/qt6ct.conf"

missing=$(find "$DEST" \( -name '*.xml' -o -name '*.qss' \) -exec cat {} + \
    | awk '{
        line = $0; out = ""
        while (length(line)) {
            if (inc) {
                p = index(line, "-->")
                if (!p) { line = ""; break }
                line = substr(line, p + 3); inc = 0
            } else {
                p = index(line, "<!--")
                if (!p) { out = out line; break }
                out = out substr(line, 1, p - 1)
                line = substr(line, p + 4); inc = 1
            }
        }
        print out
    }' \
    | grep -oE '(src="|url\()/[^")]*' | sed -e 's/^src="//' -e 's/^url(//' | grep -v '<' | sort -u \
    | while IFS= read -r ref; do [ -e "$ref" ] || echo "$ref"; done)
[ -z "$missing" ] || die "missing references: $missing"
