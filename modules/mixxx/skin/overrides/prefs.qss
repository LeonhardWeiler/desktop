
QDialog,
QDialog QWidget {
  background-color: @bg@;
  color: @fg@;
  font-family: "@font_family@";
}

QDialog QLabel,
QDialog QCheckBox,
QDialog QRadioButton,
QDialog QGroupBox {
  background-color: transparent;
  color: @fg@;
}

QDialog QLabel:disabled,
QDialog QCheckBox:disabled,
QDialog QRadioButton:disabled {
  color: #666666;
}

QDialog QLabel a {
  color: @accent@;
}

QDialog QGroupBox {
  border: 1px solid #333333;
  border-radius: 0px;
  margin-top: 0.7em;
  padding: 0.6em 0.4em 0.4em 0.4em;
}
  QDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0.6em;
    padding: 0px 0.3em;
    color: @dim@;
  }

QDialog QFrame[frameShape="4"],
QDialog QFrame[frameShape="5"] {
  background-color: #333333;
  border: none;
}

QDialog QLineEdit,
QDialog QPlainTextEdit,
QDialog QTextEdit,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QTimeEdit {
  background-color: #1a1a1a;
  color: @fg@;
  border: 1px solid @border@;
  border-radius: 0px;
  padding: 2px 4px;
  selection-background-color: @surface@;
  selection-color: @fg@;
}

QDialog QLineEdit:focus,
QDialog QPlainTextEdit:focus,
QDialog QTextEdit:focus,
QDialog QSpinBox:focus,
QDialog QDoubleSpinBox:focus,
QDialog QTimeEdit:focus {
  border: 1px solid @accent@;
}

QDialog QLineEdit:disabled,
QDialog QSpinBox:disabled,
QDialog QDoubleSpinBox:disabled {
  background-color: #161616;
  color: #666666;
  border: 1px solid #333333;
}

QDialog QSpinBox::up-button,
QDialog QDoubleSpinBox::up-button,
QDialog QTimeEdit::up-button,
QDialog QSpinBox::down-button,
QDialog QDoubleSpinBox::down-button,
QDialog QTimeEdit::down-button {
  background-color: @surface@;
  border: 0px;
  width: 14px;
}
  QDialog QSpinBox::up-button:hover,
  QDialog QDoubleSpinBox::up-button:hover,
  QDialog QSpinBox::down-button:hover,
  QDialog QDoubleSpinBox::down-button:hover {
    background-color: #3a3a3a;
  }
  QDialog QSpinBox::up-arrow,
  QDialog QDoubleSpinBox::up-arrow,
  QDialog QTimeEdit::up-arrow,
  QDialog QSpinBox::down-arrow,
  QDialog QDoubleSpinBox::down-arrow,
  QDialog QTimeEdit::down-arrow {
    width: 7px;
    height: 5px;
  }
  QDialog QSpinBox::up-arrow,
  QDialog QDoubleSpinBox::up-arrow,
  QDialog QTimeEdit::up-arrow {
    image: url(@skin@/palemoon/buttons/btn__lib_sort_up.svg);
  }
  QDialog QSpinBox::down-arrow,
  QDialog QDoubleSpinBox::down-arrow,
  QDialog QTimeEdit::down-arrow {
    image: url(@skin@/palemoon/buttons/btn__lib_sort_down.svg);
  }

QDialog QPushButton,
QDialog QToolButton {
  background-color: @surface@;
  color: @fg@;
  border: 1px solid @border@;
  border-radius: 0px;
  padding: 3px 12px;
  min-height: 1.2em;
}
  QDialog QPushButton:hover,
  QDialog QToolButton:hover {
    background-color: #3a3a3a;
  }
  QDialog QPushButton:pressed,
  QDialog QToolButton:pressed {
    background-color: #232323;
  }
  QDialog QPushButton:default {
    border: 1px solid @accent@;
  }
  QDialog QPushButton:focus,
  QDialog QToolButton:focus {
    border: 1px solid @border_focus@;
  }
  QDialog QPushButton:disabled,
  QDialog QToolButton:disabled {
    background-color: #1e1e1e;
    color: #666666;
    border: 1px solid #333333;
  }

QDialog QCheckBox::indicator,
QDialog QRadioButton::indicator {
  width: 0.8em;
  height: 0.8em;
  border: 1px solid @border@;
  border-radius: 0px;
  background-color: #1a1a1a;
}
  QDialog QCheckBox::indicator:checked,
  QDialog QRadioButton::indicator:checked {
    background-color: @accent@;
    border: 1px solid @accent@;
  }
  QDialog QCheckBox::indicator:indeterminate {
    background-color: @border@;
  }
  QDialog QCheckBox::indicator:hover,
  QDialog QRadioButton::indicator:hover {
    border: 1px solid @border_focus@;
  }
  QDialog QCheckBox::indicator:disabled,
  QDialog QRadioButton::indicator:disabled {
    border: 1px solid #333333;
    background-color: #161616;
  }

QDialog QComboBox {
  background-color: #1a1a1a;
  color: @fg@;
  border: 1px solid @border@;
  border-radius: 0px;
  padding: 2px 4px;
  min-height: 1.2em;
}
  QDialog QComboBox:hover {
    border: 1px solid @border_focus@;
  }
  QDialog QComboBox:focus,
  QDialog QComboBox:on {
    border: 1px solid @accent@;
  }
  QDialog QComboBox:disabled {
    background-color: #161616;
    color: #666666;
    border: 1px solid #333333;
  }
  QDialog QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 16px;
    border: 0px;
    background: transparent;
  }
  QDialog QComboBox::down-arrow {
    image: url(@skin@/palemoon/buttons/btn__lib_sort_down.svg);
    width: 9px;
    height: 7px;
  }
  QDialog QComboBox QAbstractItemView {
    background-color: @bg@;
    color: @fg@;
    border: 1px solid @border@;
    selection-background-color: @surface@;
    selection-color: @fg@;
    outline: none;
  }

QDialog QAbstractItemView,
QDialog QTreeView,
QDialog QListView,
QDialog QTableView,
QDialog QTreeWidget,
QDialog QListWidget,
QDialog QTableWidget {
  background-color: @bg@;
  alternate-background-color: #191919;
  color: @fg@;
  border: 1px solid #333333;
  border-radius: 0px;
  selection-background-color: @surface@;
  selection-color: @fg@;
  outline: none;
}
  QDialog QTreeView::item,
  QDialog QListView::item,
  QDialog QTableView::item {
    padding: 2px;
    border: 0px;
  }
  QDialog QTreeView::item:selected,
  QDialog QListView::item:selected,
  QDialog QTableView::item:selected {
    background-color: @surface@;
    color: @fg@;
  }
  QDialog QTreeView::item:hover,
  QDialog QListView::item:hover {
    background-color: #1f1f1f;
  }
  QDialog QTreeView::branch {
    background-color: @bg@;
  }
  QDialog QTreeView::branch:selected {
    background-color: @surface@;
  }

DlgPreferences {
  min-width: 1400px;
}

QDialog QTreeView#contentsTreeWidget {
  min-width: 15em;
  border: 0px;
  border-right: 1px solid #333333;
}

QDialog QHeaderView::section {
  background-color: #1a1a1a;
  color: @dim@;
  border: 0px;
  border-bottom: 1px solid #333333;
  border-right: 1px solid #333333;
  padding: 3px;
}

QDialog QTabWidget::pane {
  border: 1px solid #333333;
  border-radius: 0px;
  top: -1px;
}
QDialog QTabBar::tab {
  background-color: #1a1a1a;
  color: @dim@;
  border: 1px solid #333333;
  border-bottom: 0px;
  border-radius: 0px;
  padding: 4px 12px;
  margin-right: 1px;
}
  QDialog QTabBar::tab:selected {
    background-color: @bg@;
    color: @fg@;
    border-bottom: 1px solid @bg@;
  }
  QDialog QTabBar::tab:hover:!selected {
    color: @fg@;
  }

QDialog QScrollBar:vertical {
  background-color: @bg@;
  width: 10px;
  margin: 0px;
  border: 0px;
}
QDialog QScrollBar:horizontal {
  background-color: @bg@;
  height: 10px;
  margin: 0px;
  border: 0px;
}
  QDialog QScrollBar::handle:vertical,
  QDialog QScrollBar::handle:horizontal {
    background-color: #3a3a3a;
    border-radius: 0px;
    min-height: 24px;
    min-width: 24px;
  }
  QDialog QScrollBar::handle:hover {
    background-color: @border@;
  }
  QDialog QScrollBar::add-line,
  QDialog QScrollBar::sub-line {
    height: 0px;
    width: 0px;
    border: 0px;
    background: transparent;
  }
  QDialog QScrollBar::add-page,
  QDialog QScrollBar::sub-page {
    background: transparent;
  }

QDialog QScrollArea {
  border: 0px;
}

QDialog QSlider::groove:horizontal {
  background-color: #2a2a2a;
  height: 3px;
  border: 0px;
}
QDialog QSlider::groove:vertical {
  background-color: #2a2a2a;
  width: 3px;
  border: 0px;
}
  QDialog QSlider::handle:horizontal {
    background-color: @accent@;
    width: 9px;
    margin: -6px 0px;
    border-radius: 0px;
  }
  QDialog QSlider::handle:vertical {
    background-color: @accent@;
    height: 9px;
    margin: 0px -6px;
    border-radius: 0px;
  }
  QDialog QSlider::sub-page:horizontal {
    background-color: #3a4e46;
  }

QDialog QProgressBar {
  background-color: #1a1a1a;
  border: 1px solid #333333;
  border-radius: 0px;
  text-align: center;
  color: @fg@;
}
  QDialog QProgressBar::chunk {
    background-color: @accent@;
  }

QMenu {
  background-color: @bg@;
  color: @fg@;
  border: 1px solid @border@;
  padding: 2px;
}
  QMenu::item {
    padding: 3px 20px 3px 20px;
  }
  QMenu::item:selected {
    background-color: @surface@;
  }
  QMenu::item:disabled {
    color: #666666;
  }
  QMenu::separator {
    height: 1px;
    background-color: #333333;
    margin: 3px 6px;
  }

QToolTip {
  background-color: @surface@;
  color: @fg@;
  border: 1px solid @border@;
  padding: 3px;
}
