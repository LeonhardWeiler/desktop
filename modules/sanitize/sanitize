SELF=${0##*/}
OUTDIR=${SANITIZE_OUTDIR:-${XDG_RUNTIME_DIR:-/tmp}/sanitized}
INPLACE=0
KEEPNAME=0
QUIET=0
TOPNG=0
STATUS=0

usage() {
  cat <<EOF
Usage: $SELF [-i] [-k] [-o DIR] [-p] [-q] FILE...

Write a metadata-free copy of each FILE and print its path.

  -i, --in-place    replace the original instead of writing a copy
  -k, --keep-name   keep the original file name (it may leak date or place)
  -o, --out DIR     where to write the copies (default: $OUTDIR)
  -p, --png         re-encode images as PNG, the type a clipboard offer can
                    rely on; other formats keep theirs
  -q, --quiet       no progress on stderr, only errors
  -h, --help        show this help
EOF
}

warn() { [ "$QUIET" = 1 ] || printf '%s: %s\n' "$SELF" "$1" >&2; }
err()  { printf '%s: %s\n' "$SELF" "$1" >&2; STATUS=1; }

while [ $# -gt 0 ]; do
  case $1 in
    -i|--in-place)  INPLACE=1 ;;
    -k|--keep-name) KEEPNAME=1 ;;
    -o|--out)       [ $# -ge 2 ] || { usage >&2; exit 1; }; OUTDIR=$2; shift ;;
    -p|--png)       TOPNG=1 ;;
    -q|--quiet)     QUIET=1 ;;
    -h|--help)      usage; exit 0 ;;
    --)             shift; break ;;
    -*)             usage >&2; exit 1 ;;
    *)              break ;;
  esac
  shift
done

[ $# -gt 0 ] || { usage >&2; exit 1; }

WORK=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/sanitize.XXXXXX") || exit 1
trap 'rm -rf "$WORK"' EXIT HUP INT TERM

neutral_name() {
  printf '%s-%s%s' "$1" \
    "$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')" "$2"
}

extension() {
  case $1 in
    *.*) printf '.%s' "${1##*.}" ;;
    *)   ;;
  esac
}

for src; do
  [ -f "$src" ] || { err "not a file: $src"; continue; }
  [ -r "$src" ] || { err "not readable: $src"; continue; }

  MIME=$(file --mime-type -b -- "$src" 2>/dev/null) || MIME=
  case $MIME in
    image/svg+xml) KIND=document ;;
    image/*)       KIND=image ;;
    video/*)       KIND=video ;;
    audio/*)       KIND=audio ;;
    *)             KIND=document ;;
  esac

  EXT=$(extension "$src")

  CONVERTED=0
  case $TOPNG:$MIME in
    1:image/png) ;;
    1:image/*)
      if ffmpeg -nostdin -v error -y -i "$src" \
                -frames:v 1 -update 1 -fflags +bitexact -f image2 -c:v png \
                "$WORK/png.png" </dev/null >/dev/null 2>&1
      then
        EXT=.png
        KIND=image
        CONVERTED=1
      else
        warn "cannot render as png, keeping $MIME: ${src##*/}"
      fi
      ;;
  esac

  TMP=$WORK/work$EXT
  rm -f "$TMP"
  if [ "$CONVERTED" = 1 ]; then
    mv -f "$WORK/png.png" "$TMP"
  else
    cp -- "$src" "$TMP" || { err "cannot copy: $src"; continue; }
  fi

  OK=1
  case $KIND in
    image)
      exiftool -all= -overwrite_original -q -q -- "$TMP" || OK=0
      ;;
    video|audio)
      ffmpeg -nostdin -v error -y -i "$TMP" \
             -map_metadata -1 -map_chapters -1 -c copy \
             -fflags +bitexact "$WORK/av$EXT" </dev/null || OK=0
      [ "$OK" = 1 ] && mv -f "$WORK/av$EXT" "$TMP"
      ;;
    document)
      mat2 --inplace -- "$TMP" >/dev/null || OK=0
      ;;
  esac

  [ "$OK" = 1 ] || { err "could not strip metadata: $src"; continue; }

  if [ "$KEEPNAME" = 1 ]; then
    NAME=$(basename -- "$src")
  else
    NAME=$(neutral_name "$KIND" "$EXT")
  fi

  if [ "$INPLACE" = 1 ] && [ "$KEEPNAME" = 1 ]; then
    DEST=$src
  elif [ "$INPLACE" = 1 ]; then
    DEST=$(dirname -- "$src")/$NAME
  else
    mkdir -p "$OUTDIR" || { err "cannot create $OUTDIR"; continue; }
    DEST=$OUTDIR/$NAME
  fi

  if [ "$KEEPNAME" = 0 ] && [ -e "$DEST" ]; then
    err "target exists: $DEST"
    continue
  fi

  mv -f "$TMP" "$DEST" || { err "cannot write: $DEST"; continue; }
  chmod 600 "$DEST" 2>/dev/null
  touch "$DEST"
  if [ "$INPLACE" = 1 ] && [ "$KEEPNAME" = 0 ]; then
    rm -f -- "$src"
  fi

  warn "cleaned ${src##*/} -> $DEST"
  printf '%s\n' "$DEST"
done

exit "$STATUS"
