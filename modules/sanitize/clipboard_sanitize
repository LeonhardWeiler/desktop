SELF=${0##*/}
STATE_DIR=${XDG_RUNTIME_DIR:-/tmp}/clipboard-sanitize
TYPES='image/png image/jpeg image/webp image/tiff image/gif image/avif'
STATE=$STATE_DIR/last-output

usage() {
  cat <<EOF
Usage: $SELF

Watch the Wayland clipboard and strip metadata from images copied into it.
Types: $TYPES

  --handle MIME   internal: clean one clipboard payload read from stdin
  -h, --help      show this help
EOF
}

preferred_type() {
  offered=$(wl-paste --list-types 2>/dev/null) || return 1
  for candidate in $TYPES; do
    if printf '%s\n' "$offered" | grep -qxF -- "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

handle() {
  mime=$1
  case $mime in
    image/png)  ext=.png ;;
    image/jpeg) ext=.jpg ;;
    image/webp) ext=.webp ;;
    image/tiff) ext=.tif ;;
    image/gif)  ext=.gif ;;
    image/avif) ext=.avif ;;
    *)          ext=.bin ;;
  esac

  tmp=$(mktemp "$STATE_DIR/clip.XXXXXX$ext") || exit 0
  out=
  trap 'rm -f "$tmp" ${out:+"$out"}' EXIT HUP INT TERM

  cat >"$tmp"
  [ -s "$tmp" ] || exit 0

  [ "$mime" = "$(preferred_type)" ] || exit 0

  before=$(sha256sum <"$tmp" | cut -d' ' -f1)

  [ -r "$STATE" ] && [ "$before" = "$(cat "$STATE")" ] && exit 0

  out=$(sanitize -q --png -o "$STATE_DIR" -- "$tmp") || exit 0
  [ -s "$out" ] || exit 0

  after=$(sha256sum <"$out" | cut -d' ' -f1)
  [ "$after" = "$before" ] && exit 0

  printf '%s' "$after" >"$STATE"
  wl-copy --type image/png <"$out"
}

case "${1:-}" in
  --handle)  [ $# -eq 2 ] || { usage >&2; exit 1; }; handle "$2"; exit 0 ;;
  -h|--help) usage; exit 0 ;;
  "")        ;;
  *)         usage >&2; exit 1 ;;
esac

mkdir -p "$STATE_DIR" || exit 1
chmod 700 "$STATE_DIR" 2>/dev/null

for type in $TYPES; do
  wl-paste --type "$type" --watch "$0" --handle "$type" &
done

wait
